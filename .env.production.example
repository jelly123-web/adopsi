# Copy this file to .env.production on the VPS, then set secure values.
POSTGRES_DB=adopsi
POSTGRES_USER=adopsi
POSTGRES_PASSWORD=replace-with-a-long-random-password
HTTP_PORT=80
FRONTEND_URL=https://adopsi.secretlabs.cloud

# Required only when Google sign-in is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://adopsi.secretlabs.cloud/auth/google/callback
